# Copy to .env, change the values, then run: set -a; source .env; set +a
# .env is ignored by Git. Terraform still stores Kubernetes Secret values in local state.
TF_VAR_minio_root_user=minioadmin
TF_VAR_minio_root_password=local-minio-change-me
TF_VAR_grafana_admin_password=local-grafana-change-me
